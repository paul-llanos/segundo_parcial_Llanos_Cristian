<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="377.0" prefWidth="674.0" xmlns="http://javafx.com/javafx/27.0.1.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controler.ProductosController">
   <children>
      <Label layoutX="35.0" layoutY="25.0" text="Productos" />
      <TableView fx:id="tablaProducto" layoutX="35.0" layoutY="55.0" prefHeight="250.0" prefWidth="250.0">
        <columns>
          <TableColumn fx:id="colNombre" prefWidth="100.0" text="Nombre" />
          <TableColumn fx:id="colPrecio" prefWidth="80.0" text="Precio" />
          <TableColumn fx:id="colStock" prefWidth="68.0" text="Stock" />
        </columns>
      </TableView>

      <Label layoutX="305.0" layoutY="115.0" text="Cantidad" />
      <TextField fx:id="txtCantidad" layoutX="365.0" layoutY="111.0" prefWidth="55.0" />
      <Button layoutX="315.0" layoutY="150.0" mnemonicParsing="false" onAction="#agregarCarrito" text="Agregar" />

      <Label layoutX="435.0" layoutY="25.0" text="Carrito" />
      <ListView fx:id="listCarrito" layoutX="435.0" layoutY="55.0" prefHeight="220.0" prefWidth="209.0" />
      <Button layoutX="485.0" layoutY="285.0" mnemonicParsing="false" onAction="#confirmarCompra" text="Confirmar Compra" />

      <Label fx:id="lblMensaje" layoutX="35.0" layoutY="325.0" text="" />
   </children>
</AnchorPane>
